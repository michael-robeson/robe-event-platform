{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robe.land/schemas/workbench-service-descriptor.v1.schema.json",
  "title": "Workbench service descriptor version 1",
  "type": "object",
  "required": ["schema_version", "service", "health", "messaging"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "service": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "health": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^?#]*$" }
      }
    },
    "messaging": {
      "type": "object",
      "required": ["provider", "project_id", "topics", "subscriptions"],
      "properties": {
        "provider": { "const": "google-cloud-pubsub" },
        "project_id": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "role"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
              "name": { "type": "string", "minLength": 1 },
              "role": { "enum": ["publishes", "consumes", "dead_letter"] }
            }
          }
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "topic_id", "delivery"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
              "name": { "type": "string", "minLength": 1 },
              "topic_id": { "type": "string", "minLength": 1, "pattern": "^[^/]+$" },
              "delivery": { "enum": ["push", "pull"] },
              "endpoint": { "type": "string", "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^?#]*$" }
            },
            "allOf": [
              {
                "if": { "properties": { "delivery": { "const": "push" } } },
                "then": { "required": ["endpoint"] }
              },
              {
                "if": { "properties": { "delivery": { "const": "pull" } } },
                "then": { "not": { "required": ["endpoint"] } }
              }
            ]
          }
        }
      }
    }
  }
}
