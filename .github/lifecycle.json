{
  "schema": 1,
  "base": "develop",
  "feature_prefix": "feature/",
  "merge_strategy": "merge",
  "commit_gate": {
    "commands": []
  },
  "readiness_gate": {
    "commands": [
      [".venv/bin/python", "-m", "compileall", "-q", "src", "tests"],
      [".venv/bin/python", "-m", "pytest", "tests/unit", "-q"],
      [".venv/bin/python", "-m", "eng_lifecycle.metadata", "check", "--repo", "."]
    ]
  },
  "integration_gate": {
    "commands": []
  },
  "required_ci": [
    "Unit tests",
    "Pub/Sub and PostgreSQL integration"
  ],
  "required_review": false,
  "special_authorization": [
    "database",
    "docker"
  ]
}
