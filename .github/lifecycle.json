{
  "schema": 1,
  "base": "develop",
  "feature_prefix": "feature/",
  "merge_strategy": "merge",
  "commit_gate": {
    "commands": []
  },
  "readiness_gate": {
    "commands": [
      ["python3", "-m", "compileall", "-q", "src", "tests"],
      ["python3", "-m", "pytest", "tests/unit", "-q"]
    ]
  },
  "integration_gate": {
    "commands": []
  },
  "required_ci": [
    "Unit tests",
    "Pub/Sub and PostgreSQL integration"
  ],
  "required_review": true,
  "special_authorization": [
    "database",
    "docker"
  ]
}
